{"park_id": "jiuzhaigou_scenic_area", "data_source": "official", "created_at": "2026-09-30T00:00:00+00:00", "attraction_id": "attr_002", "name": "犀牛海", "valley": "树正沟", "category": "湖泊/海子", "description": "长 2000 米、宽 225 米、深 17 米，是九寨沟第二大湖泊。相传一位病重的得道高僧骑着犀牛来到此处，喝了湖边神泉后不治而愈，便将爱骑犀牛留在此处，因此得名。春夏湖水一片翠绿，秋高气爽时满山秋色倒映湖中，更胜实景。", "highlights": "景区第二大湖、秋色倒影胜实景、神泉传说", "elevation_meters": 2301, "elevation_note": null, "elevation_source": "official", "opening_hours": "旺季 08:00-18:00（08:00-14:00 入园）；淡季 08:30-18:00（08:30-14:00 入园）", "opening_hours_source": "park_level", "ticket_price": 0, "ticket_note": "九寨沟景点不单独售票，含于景区门票（旺季 190 元 / 淡季 80 元）。", "visit_duration_minutes": 10, "visit_duration_source": "third_party", "difficulty": "轻松", "difficulty_source": "derived", "suitable_for": ["普通游客", "亲子家庭", "老年游客"], "suitable_for_source": "derived", "latitude": 33.205, "longitude": 103.913, "coordinate_source": "estimated", "in_standard_tour": true, "seasonal_closure": null, "notice": "请沿指定栈道游览，请勿离开栈道；景区内严禁吸烟、禁止下滩踩水与游泳、禁止投喂野生动物，请勿携带宠物入园。", "notice_extra": null, "status": "open", "updated_at": "2026-09-30T00:00:00+00:00", "source_ids": ["src_02", "src_05", "src_24"]}
