{"park_id": "jiuzhaigou_scenic_area", "data_source": "official", "created_at": "2026-09-30T00:00:00+00:00", "attraction_id": "attr_006", "name": "树正寨", "valley": "树正沟", "category": "藏寨人文", "description": "树正沟内的藏羌村落，寨后有一座海拔 4200 米的达戈男神山，面对树正群海。寨内建有「九宝莲花菩提塔」，代表九个藏族寨子团结、祥和、幸福；曾建设民族文化村，可观赏九寨沟藏式建筑风格、彩绘及藏民服饰，体验藏民日常生活。", "highlights": "九宝莲花菩提塔、七彩经幡、白塔、藏式民居", "elevation_meters": null, "elevation_note": null, "elevation_source": null, "opening_hours": "旺季 08:00-18:00（08:00-14:00 入园）；淡季 08:30-18:00（08:30-14:00 入园）", "opening_hours_source": "park_level", "ticket_price": 0, "ticket_note": "九寨沟景点不单独售票，含于景区门票（旺季 190 元 / 淡季 80 元）。", "visit_duration_minutes": 30, "visit_duration_source": "third_party", "difficulty": "轻松", "difficulty_source": "derived", "suitable_for": ["普通游客", "摄影爱好者"], "suitable_for_source": "derived", "latitude": 33.212, "longitude": 103.917, "coordinate_source": "estimated", "in_standard_tour": true, "seasonal_closure": null, "notice": "请沿指定栈道游览，请勿离开栈道；景区内严禁吸烟、禁止下滩踩水与游泳、禁止投喂野生动物，请勿携带宠物入园。", "notice_extra": null, "status": "open", "updated_at": "2026-09-30T00:00:00+00:00", "source_ids": ["src_02", "src_05", "src_24"]}
{"park_id": "jiuzhaigou_scenic_area", "data_source": "official", "created_at": "2026-09-30T00:00:00+00:00", "attraction_id": "attr_007", "name": "树正群海", "valley": "树正沟", "category": "湖泊群", "description": "在河谷迭加泥石流堆积物基础上再经钙华沉积，形成大小 19 个湖泊，顺沟谷层层迭迭，森林、湖泊、小瀑布相错相连，有「树在水中生，水在林间流，人在画中游」之说。", "highlights": "19 个钙华湖泊层层迭迭、「树在水中生」", "elevation_meters": 2187, "elevation_note": "2187—2280 米", "elevation_source": "official", "opening_hours": "旺季 08:00-18:00（08:00-14:00 入园）；淡季 08:30-18:00（08:30-14:00 入园）", "opening_hours_source": "park_level", "ticket_price": 0, "ticket_note": "九寨沟景点不单独售票，含于景区门票（旺季 190 元 / 淡季 80 元）。", "visit_duration_minutes": 40, "visit_duration_source": "third_party", "difficulty": "轻松", "difficulty_source": "derived", "suitable_for": ["普通游客", "摄影爱好者", "亲子家庭"], "suitable_for_source": "derived", "latitude": 33.213, "longitude": 103.918, "coordinate_source": "estimated", "in_standard_tour": true, "seasonal_closure": null, "notice": "请沿指定栈道游览，请勿离开栈道；景区内严禁吸烟、禁止下滩踩水与游泳、禁止投喂野生动物，请勿携带宠物入园。", "notice_extra": null, "status": "open", "updated_at": "2026-09-30T00:00:00+00:00", "source_ids": ["src_02", "src_05", "src_24"]}
{"park_id": "jiuzhaigou_scenic_area", "data_source": "official", "created_at": "2026-09-30T00:00:00+00:00", "attraction_id": "attr_008", "name": "卧龙海", "valley": "树正沟", "category": "湖泊/海子", "description": "长约 253 米、水深 24 米。水底有一条乳黄色钙华堤埂，外形像沉卧水中的巨龙；湖面平静时卧龙似沉睡水底，微风起涟漪则龙身蠕动，风强时湖面破碎如龙腾空。", "highlights": "水下钙华「卧龙」、风起变幻", "elevation_meters": 2220, "elevation_note": null, "elevation_source": "official", "opening_hours": "旺季 08:00-18:00（08:00-14:00 入园）；淡季 08:30-18:00（08:30-14:00 入园）", "opening_hours_source": "park_level", "ticket_price": 0, "ticket_note": "九寨沟景点不单独售票，含于景区门票（旺季 190 元 / 淡季 80 元）。", "visit_duration_minutes": 15, "visit_duration_source": "estimated", "difficulty": "轻松", "difficulty_source": "derived", "suitable_for": ["普通游客", "摄影爱好者"], "suitable_for_source": "derived", "latitude": 33.218, "longitude": 103.919, "coordinate_source": "estimated", "in_standard_tour": true, "seasonal_closure": null, "notice": "请沿指定栈道游览，请勿离开栈道；景区内严禁吸烟、禁止下滩踩水与游泳、禁止投喂野生动物，请勿携带宠物入园。", "notice_extra": null, "status": "open", "updated_at": "2026-09-30T00:00:00+00:00", "source_ids": ["src_02", "src_05"]}
{"park_id": "jiuzhaigou_scenic_area", "data_source": "official", "created_at": "2026-09-30T00:00:00+00:00", "attraction_id": "attr_009", "name": "火花海", "valley": "树正沟", "category": "湖泊/海子", "description": "长 294 米、宽 232 米、深 16 米、库容 45 万 m³，因阳光斜射湖面波光粼粼似火花闪烁而得名。2017 年 7.0 级地震使出水口堤坝崩塌形成长 40 米、宽 12 米、深 15 米的决口，湖泊景观消失并发育裂缝 100 余条；后以震损钙华、落石、糯米灰浆等生态材料修复坝体与裂缝，恢复湖泊景观。", "highlights": "震后生态修复典范、波光粼粼似火花", "elevation_meters": 2211, "elevation_note": null, "elevation_source": "official", "opening_hours": "旺季 08:00-18:00（08:00-14:00 入园）；淡季 08:30-18:00（08:30-14:00 入园）", "opening_hours_source": "park_level", "ticket_price": 0, "ticket_note": "九寨沟景点不单独售票，含于景区门票（旺季 190 元 / 淡季 80 元）。", "visit_duration_minutes": 15, "visit_duration_source": "estimated", "difficulty": "轻松", "difficulty_source": "derived", "suitable_for": ["普通游客", "亲子家庭"], "suitable_for_source": "derived", "latitude": 33.221, "longitude": 103.92, "coordinate_source": "estimated", "in_standard_tour": true, "seasonal_closure": null, "notice": "请沿指定栈道游览，请勿离开栈道；景区内严禁吸烟、禁止下滩踩水与游泳、禁止投喂野生动物，请勿携带宠物入园。", "notice_extra": null, "status": "open", "updated_at": "2026-09-30T00:00:00+00:00", "source_ids": ["src_02", "src_05"]}
