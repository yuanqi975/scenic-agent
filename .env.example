# Runtime
ENVIRONMENT=development
PARK_ID=jiuzhaigou_scenic_area
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Amap current weather (九寨沟县 adcode=513225)
AMAP_WEATHER_KEY=
AMAP_WEATHER_CITY=513225
AMAP_API_BASE_URL=https://restapi.amap.com

# Database / cache
POSTGRES_DB=scenic_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/scenic_agent
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# Production protection. Capacity tests use loadtests/compose.throughput.yml.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_RECOMMEND_PER_MINUTE=30
RATE_LIMIT_STREAM_PER_MINUTE=60
SSE_MAX_CONCURRENCY=100
WEB_CONCURRENCY=2
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=30
LLM_CIRCUIT_COOLDOWN_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5

# Admin auth: replace every value before ENVIRONMENT=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET

# SiliconFlow-compatible embedding endpoint. Keep real keys only in .env.
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSION=2560

# Model providers
LLM_MODE=fallback
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-terra

# Retrieval backend: Milvus Dense + native BM25, with PostgreSQL entity/structured fallback
RAG_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=scenic_knowledge
MILVUS_TIMEOUT_SECONDS=3

# Hybrid retrieval: retrieve broadly, then fuse and rerank down to RETRIEVAL_TOP_K.
RAG_DENSE_TOP_K=40
RAG_SPARSE_TOP_K=40
RAG_ENTITY_TOP_K=40
RAG_MAX_QUERY_VARIANTS=4
RAG_RERANK_CANDIDATES=40
MINIO_IMAGE=bitnamilegacy/minio:2024.8.26
